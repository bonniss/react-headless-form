{
  "name": "react-headless-form",
  "description": "Form as configuration. Bring your own UI, entirely. Great DX. Built on React Hook Form.",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "version": "0.18.0",
  "packageManager": "pnpm@10.12.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonniss/react-headless-form.git"
  },
  "main": "./dist/react-headless-form.umd.cjs",
  "module": "./dist/react-headless-form.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/react-headless-form.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/react-headless-form.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.build.json",
    "dev": "ladle serve",
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/copy-dmts.mjs",
    "static": "ladle build --viteConfig .ladle/vite-build.config.ts",
    "preview": "ladle preview",
    "lint": "npx @biomejs/biome lint --write ./src",
    "format": "npx @biomejs/biome check --write --organize-imports-enabled=true ./src",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "lint:ci": "biome lint ./src",
    "check:types": "tsc -p test/types && tsc -p test/types/register",
    "check:package": "node scripts/check-package.mjs && publint && attw --pack .",
    "verify": "pnpm lint:ci && pnpm typecheck && pnpm typecheck:test && vitest run && pnpm build && pnpm check:types && pnpm check:package",
    "bench": "vitest bench --run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "~0.18.5",
    "@babel/core": "7.27.4",
    "@biomejs/biome": "2.0.4",
    "@formisch/react": "1.2.0",
    "@hookform/devtools": "^4.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@ladle/react": "^5.1.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "10.4.21",
    "babel-loader": "10.0.0",
    "esbuild": "0.25.5",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.1.2",
    "prism-react-renderer": "^2.4.1",
    "publint": "0.3.25",
    "react": "^18",
    "react-dom": "^18",
    "react-headless-form-0.14": "npm:react-headless-form@0.14.0",
    "react-hook-form": "^7.62.0",
    "typescript": "5.8.3",
    "valibot": "^1.5.0",
    "vite": "6.3.5",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "3.2.4",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.8.0 || ^17 || ^18 || ^19",
    "react-hook-form": "^7.55.0"
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,json,jsonc}": [
      "biome check --files-ignore-unknown=true",
      "biome check --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched --files-ignore-unknown=true",
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
