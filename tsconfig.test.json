{
  // Type-checks tests, stories and the docs examples. Docs examples import
  // `react-headless-form`, React and RHF; map them to the repo copies (docs has
  // its own node_modules with other versions). Not used by the build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["src/lib/*"],
      "react-headless-form": ["src/lib/index.ts"],
      "react-hook-form": ["node_modules/react-hook-form"],
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src", ".ladle", "docs/src/examples", "docs/integrations/shared"],
  // Need packages installed only in docs/ (i18next, react-intl, Lingui, Paraglide output); CI installs
  // the root dependencies only.
  "exclude": [
    "docs/src/examples/_shared/EgI18nI18next.tsx",
    "docs/src/examples/_shared/EgI18nReactIntl.tsx",
    "docs/src/examples/_shared/EgI18nLingui.tsx",
    "docs/src/examples/_shared/EgI18nParaglide.tsx",
    "docs/src/examples/_shared/paraglide"
  ]
}
